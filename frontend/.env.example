# ==========================================================================
#  ScamShield AI — frontend build-time environment variables (Vite)
#  Copy this file to ".env" and edit as needed. Both have safe defaults.
#  NOTE: Vite inlines these at BUILD time, so rebuild after changing them.
# ==========================================================================

# URL of the ScamShield AI backend (FastAPI).
# Local development default is http://localhost:8000.
# When you deploy to Render, set this to your backend service URL, e.g.
#   VITE_API_URL=https://scamshield-api.onrender.com
VITE_API_URL=http://localhost:8000

# Public URL of this site — used for SEO canonical tags, Open Graph URLs and
# the generated sitemap.xml / robots.txt / llms.txt.
# Defaults to https://www.scamshield-ai.com if unset. Set this to wherever the
# frontend is actually served, e.g.
#   VITE_SITE_URL=https://scamshield-web.onrender.com
VITE_SITE_URL=http://localhost:5173
