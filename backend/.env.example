# ==========================================================================
#  ScamShield AI — backend environment variables
#  Copy this file to ".env" (same folder) and fill in what you have.
#  EVERYTHING HERE IS OPTIONAL — the app runs fully in Demo Mode with none of it.
# ==========================================================================

# --- Database -------------------------------------------------------------
# Leave this commented out to use a local SQLite file (zero setup, recommended
# for local development). Uncomment + edit to use PostgreSQL (e.g. on Render).
# DATABASE_URL=postgresql://user:password@localhost:5432/scamshield
# (Render gives you a "postgres://..." URL — that's fine, the app rewrites it.)

# --- Claude LLM (optional) ------------------------------------------------
# Used to generate polished, human-readable threat explanations.
# WITHOUT this key the app still works — it uses built-in template explanations.
# Get a key at https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-haiku-4-5-20251001

# --- VirusTotal (optional) ------------------------------------------------
# Used for real URL/domain reputation checks (free tier ~4 requests/min).
# WITHOUT this key the URL agent uses pattern rules only (still works fine).
# Get a free key at https://www.virustotal.com/gui/my-apikey
# VIRUSTOTAL_API_KEY=your_virustotal_key_here

# --- Demo / behaviour flags ----------------------------------------------
# DEMO_MODE=true  -> globally force offline template explanations + canned VT
#                    verdicts (the frontend toggle also controls this per-request).
DEMO_MODE=false
# AUTO_SEED=true  -> on first startup, if the DB is empty, load the connected
#                    demo scam campaign so the dashboard/network are populated.
AUTO_SEED=true

# --- CORS -----------------------------------------------------------------
# Comma-separated list of allowed frontend origins, or "*" for any (hackathon default).
CORS_ORIGINS=*
